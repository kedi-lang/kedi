```
from pathlib import Path
import shutil

_ROOT = Path.cwd().resolve()
_MAX_READ_BYTES = 1_000_000
_MAX_DIRECTORY_ENTRIES = 1_000

def _safe_path(raw_path: str, *, for_delete: bool = False) -> Path:
    path = Path(raw_path).expanduser()
    if not path.is_absolute():
        path = _ROOT / path
    resolved = path.resolve()
    if not resolved.is_relative_to(_ROOT):
        raise PermissionError(f"path escapes filesystem root: {raw_path}")
    # Destructive ops only: "." / "" resolve to _ROOT itself — deleting that (or an anchor/home that
    # _ROOT happens to coincide with) would wipe the whole sandbox. Guarding at this single chokepoint
    # protects every delete op symmetrically; reads/lists/writes of the root remain allowed.
    if for_delete and resolved in {_ROOT, Path(resolved.anchor).resolve(), Path.home().resolve()}:
        raise PermissionError(f"refusing to delete a protected root directory: {resolved}")
    return resolved
```

@read_text_file(file_path: str) -> str:
    ###
    Read a UTF-8 text file.

    Args:
        file_path (str): Path to the file.

    Returns:
        str: File contents.
    ###
    = ```
    path = _safe_path(file_path)
    if path.stat().st_size > _MAX_READ_BYTES:
        raise ValueError(f"file is too large to read: {file_path}")
    return path.read_text(encoding="utf-8")
    ```

@write_text_file(file_path: str, content: str) -> str:
    ###
    Write a complete UTF-8 text file, creating parent directories as needed.

    Args:
        file_path (str): Path to the file.
        content (str): Complete file content.

    Returns:
        str: The written file path.
    ###
    = ```
    path = _safe_path(file_path)
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(content, encoding="utf-8")
    return str(path)
    ```

@apply_patch(operation: str, file_path: str, content: str = `""`, old_text: str = `""`, new_text: str = `""`) -> str:
    ###
    Apply a structured text-file edit.

    Supported operations:
    - add: create a new file with content
    - update: replace old_text with new_text exactly once
    - append: append content to the file

    Args:
        operation (str): One of add, update, append.
        file_path (str): Path to edit, relative to the current working directory.
        content (str): Content for add or append.
        old_text (str): Existing text to replace for update.
        new_text (str): Replacement text for update.

    Returns:
        str: Summary of applied file operations.
    ###
    = ```
    op = operation.strip().lower()
    path = _safe_path(file_path)
    if op == "add":
        if path.exists():
            raise FileExistsError(f"file already exists: {file_path}")
        path.parent.mkdir(parents=True, exist_ok=True)
        path.write_text(content, encoding="utf-8")
        return f"added {path}"
    if op == "update":
        if old_text == "":
            raise ValueError("old_text must not be empty for update")
        text = path.read_text(encoding="utf-8")
        matches = text.count(old_text)
        if matches == 0:
            raise ValueError(f"old_text not found in {file_path}")
        if matches > 1:
            raise ValueError(f"old_text is ambiguous in {file_path}")
        path.write_text(text.replace(old_text, new_text, 1), encoding="utf-8")
        return f"updated {path}"
    if op == "append":
        path.parent.mkdir(parents=True, exist_ok=True)
        with path.open("a", encoding="utf-8") as handle:
            handle.write(content)
        return f"appended {path}"
    raise ValueError("operation must be one of: add, update, append")
    ```

@path_exists(path: str) -> bool:
    ###
    Check whether a file or directory exists.

    Args:
        path (str): Path to check.

    Returns:
        bool: True when the path exists.
    ###
    = ```
    return _safe_path(path).exists()
    ```

@list_directory(dir_path: str) -> list[str]:
    ###
    List direct children of a directory.

    Args:
        dir_path (str): Directory path.

    Returns:
        list[str]: Child names sorted alphabetically.
    ###
    = ```
    entries = sorted(path.name for path in _safe_path(dir_path).iterdir())
    if len(entries) > _MAX_DIRECTORY_ENTRIES:
        raise ValueError(f"directory has too many entries: {dir_path}")
    return entries
    ```

@create_directory(dir_path: str) -> str:
    ###
    Create a directory and any missing parent directories.

    Args:
        dir_path (str): Directory path.

    Returns:
        str: The created directory path.
    ###
    = ```
    path = _safe_path(dir_path)
    path.mkdir(parents=True, exist_ok=True)
    return str(path)
    ```

@remove_file(file_path: str) -> str:
    ###
    Delete a file.

    Args:
        file_path (str): File path.

    Returns:
        str: The deleted file path.
    ###
    = ```
    path = _safe_path(file_path, for_delete=True)
    path.unlink()
    return str(path)
    ```

@remove_directory(dir_path: str) -> str:
    ###
    Delete a directory tree.

    Args:
        dir_path (str): Directory path.

    Returns:
        str: The deleted directory path.
    ###
    = ```
    path = _safe_path(dir_path, for_delete=True)
    shutil.rmtree(path)
    return str(path)
    ```

@get_file_info(path: str) -> dict:
    ###
    Return basic metadata for a file or directory.

    Args:
        path (str): Path to inspect.

    Returns:
        dict: Basic path metadata.
    ###
    = ```
    p = _safe_path(path)
    stat = p.stat()
    return {
        "path": str(p),
        "name": p.name,
        "is_file": p.is_file(),
        "is_dir": p.is_dir(),
        "size": stat.st_size,
        "modified_time": stat.st_mtime,
    }
    ```

