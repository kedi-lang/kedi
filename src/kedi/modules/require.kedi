###
Module for managing package requirements.
###

> import: errors

```
import importlib.util

def package_is_installed(package_name: str) -> bool:
    return importlib.util.find_spec(package_name) is not None

def require(
    package_names: str | list[str],
    required_by: str | None = None,
) -> bool:
    names = [package_names] if isinstance(package_names, str) else list(package_names)
    not_installed = [name for name in names if not package_is_installed(name)]
    if not_installed:
        raise ModuleNotInstalledError(package_names=not_installed, required_by=required_by)
    return True
```

> export:
    require
