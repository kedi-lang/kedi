d = {"meow"[i]: i for i in range(4)}

r = bytearray()

b = 0
n = 0
i = 0

while i < len(s):
    if s.startswith("miyav", i):
        r.append(32)
        i = i + 5
    else:
        c = s[i]

        if c in d:
            b = b * 4 + d[c]
            n = n + 1

            if n == 4:
                r.append(b)
                b = 0
                n = 0

        i = i + 1

print(r.decode("utf-8"))
