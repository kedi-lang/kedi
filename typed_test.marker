@generate_question():
    [question] is a challenging trivia question.
    <`print(f">{question}...")`>
    = <question>

@generate_questions(number :int) -> list[str]:
    [questions: list[str]] = `[]`
    ```
    for i in range(number):
        questions.append(generate_question())
    ```
    = `questions`


@process_questions(questions :list[str]) -> list[str]:
    [processed_questions: list[str]] = `[]`
    ```
    for question in questions:
        processed_questions.append(process_question(question))
    ```
    = `processed_questions`

@process_question(question :str) -> str:
    = <question> PROCESSED

@foo(mylist: list[int], mystr: str):
    = <mylist><mystr>

[a] = hello world
[mylist: list[int]] = `[1,2,3]`
