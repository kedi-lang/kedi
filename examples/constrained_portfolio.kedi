  > metric: optimality(problems):
    = ```
    projects_str, budget, head_limit = problems
    projects = parse_projects(projects_str)
    best_names, best_cost, best_heads, best_value = exact_best_portfolio(projects, budget, head_limit)
    projects_by_name = {project["name"]: project for project in projects}

    result = solve_constrained_portfolio(projects_str, budget, head_limit)

    try:
        chosen_names = list(result.chosen_projects)
        reported_cost = int(result.total_cost)
        reported_heads = int(result.total_heads)
        reported_value = int(result.total_value)
        selected_cost, selected_heads, selected_value = validate_selection(
            projects_by_name,
            chosen_names,
            budget,
            head_limit,
        )
    except Exception as exc:
        return (0.0, f"Invalid portfolio: {exc}. Optimal set is {best_names} with value {best_value}.")

    normalized_names = tuple(sorted(str(name) for name in chosen_names))
    consistency = (
        (1.0 if reported_cost == selected_cost else 0.0)
        + (1.0 if reported_heads == selected_heads else 0.0)
        + (1.0 if reported_value == selected_value else 0.0)
    ) / 3.0
    optimality = selected_value / max(1, best_value)
    exact_choice = 1.0 if (
        normalized_names == best_names
        and selected_cost == best_cost
        and selected_heads == best_heads
        and selected_value == best_value
    ) else 0.0

    if exact_choice == 1.0 and consistency == 1.0:
        return (1.0, f"Optimal portfolio {best_names} with cost {best_cost}, staffing {best_heads}, value {best_value}.")

    score = round(0.7 * optimality + 0.2 * consistency + 0.1 * exact_choice, 6)
    return (
        score,
        f"Selected {normalized_names} with cost {selected_cost}, staffing {selected_heads}, value {selected_value}; optimal is {best_names} with cost {best_cost}, staffing {best_heads}, value {best_value}.",
    )
    ```

