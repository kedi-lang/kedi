#
# Harder GEPA target than knapsack or weighted interval scheduling:
# maximize project value under budget + staffing constraints with prerequisites,
# exclusions, and tie-breaking rules.
#

```
import itertools
import re

PROJECT_RE = re.compile(
    r"([A-Za-z_][A-Za-z0-9_]*)\(c\s*=\s*(\d+),\s*h\s*=\s*(\d+),\s*v\s*=\s*(\d+),\s*req\s*=\s*([A-Za-z0-9_|-]+),\s*ban\s*=\s*([A-Za-z0-9_|-]+)\)"
)

def parse_links(text):
    if text == "-":
        return tuple()
    return tuple(part for part in text.split("|") if part)

def parse_projects(text):
    projects = []
    for name, cost, heads, value, req, ban in PROJECT_RE.findall(text):
        projects.append(
            {
                "name": name,
                "cost": int(cost),
                "heads": int(heads),
                "value": int(value),
                "req": parse_links(req),
                "ban": parse_links(ban),
            }
        )
    if not projects:
        raise ValueError(f"Could not parse any projects from: {text!r}")
    return projects

def portfolio_totals(subset):
    return (
        sum(project["cost"] for project in subset),
        sum(project["heads"] for project in subset),
        sum(project["value"] for project in subset),
    )

def is_feasible(subset, budget, head_limit):
    names = {project["name"] for project in subset}
    cost, heads, _ = portfolio_totals(subset)
    if cost > budget or heads > head_limit:
        return False
    for project in subset:
        for req in project["req"]:
            if req not in names:
                return False
        for banned in project["ban"]:
            if banned in names:
                return False
    return True

def exact_best_portfolio(projects, budget, head_limit):
    best = None
    for r in range(len(projects) + 1):
        for subset in itertools.combinations(projects, r):
            if not is_feasible(subset, budget, head_limit):
                continue
            names = tuple(sorted(project["name"] for project in subset))
            cost, heads, value = portfolio_totals(subset)
            candidate = (-value, cost, heads, names)
            if best is None or candidate < best:
                best = candidate
    if best is None:
        return (tuple(), 0, 0, 0)
    neg_value, cost, heads, names = best
    return (names, cost, heads, -neg_value)

def validate_selection(projects_by_name, chosen_names, budget, head_limit):
    subset = []
    seen = set()
    for raw_name in chosen_names:
        name = str(raw_name)
        if name in seen:
            raise ValueError(f"duplicate project {name}")
        seen.add(name)
        project = projects_by_name.get(name)
        if project is None:
            raise ValueError(f"unknown project {name}")
        subset.append(project)
    if not is_feasible(subset, budget, head_limit):
        raise ValueError("selected portfolio is infeasible")
    return portfolio_totals(subset)
```

~PortfolioDecision(chosen_projects: list[str], total_cost: int, total_heads: int, total_value: int)

@solve_constrained_portfolio(projects: str, budget: int, head_limit: int) -> PortfolioDecision:
  > optimize: solver:
    Projects: <projects>
    Budget limit: <budget>
    Staffing limit: <head_limit>
    Each project lists cost, staffing, value, prerequisites, and exclusions.
    A project with prerequisites X|Y can only be chosen if X and Y are also chosen.
    A project with exclusions X|Y cannot be chosen together with X or Y.
    Choose the feasible portfolio with maximum total value.
    Tie-break in this exact order:
    1. lower total cost
    2. lower total staffing
    3. lexicographically smaller sorted project list
    Return chosen project names sorted ascending.
    Reasoning: [reasoning: str]
    Chosen projects: [chosen_projects: list[str]]
    Total cost: [total_cost: int]
    Total staffing: [total_heads: int]
    Total value: [total_value: int]

  = `PortfolioDecision(chosen_projects=chosen_projects, total_cost=total_cost, total_heads=total_heads, total_value=total_value)`

