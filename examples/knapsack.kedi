@solve_knapsack(items: str, capacity: int) -> int:
  > optimize: solver:
    <items>\n\
    Knapsack capacity: <capacity>\n\
    Pick items to maximize total value without exceeding capacity.\n\
    Reasoning: [reasoning: str]\n\
    Total value: [value: int]

  = `value`

@eval: solve_knapsack:
  > data: problems:
    = ```
    return [
        (("A(w=2,v=3), B(w=3,v=4), C(w=4,v=5), D(w=5,v=7)", 10), {"answer": 13}),
        (("X(w=1,v=1), Y(w=2,v=3), Z(w=3,v=5)", 5), {"answer": 8}),
        (("P(w=3,v=4), Q(w=4,v=5), R(w=2,v=3)", 6), {"answer": 8}),
        (("M(w=1,v=2), N(w=2,v=3), O(w=3,v=4), S(w=4,v=6)", 5), {"answer": 9}),
    ]
    ```

  > test_data: problems:
    = ```
    return [
        (("G(w=5,v=10), H(w=4,v=7), I(w=3,v=5)", 8), {"answer": 15}),
        (("A(w=1,v=1), B(w=1,v=1), C(w=1,v=1)", 2), {"answer": 2}),
    ]
    ```

  > metric: accuracy(problems):
    = ```
    items_str, capacity = problems
    capacity = int(capacity) if isinstance(capacity, str) else capacity
    pred = solve_knapsack(items_str, capacity)
    target = expected["answer"]
    try:
        got = int(pred)
    except (ValueError, TypeError):
        return (0.0, f"Could not parse answer: {pred!r}. Expected {target}.")
    if got == target:
        return (1.0, f"Correct! Value={got}.")
    diff = target - got
    partial = max(0.0, 1.0 - abs(diff) / target)
    return (partial, f"Got {got}, expected {target} (off by {diff}).")
    ```

= `solve_knapsack("A(w=2,v=3), B(w=3,v=4), C(w=4,v=8), D(w=5,v=10)", 10)`
