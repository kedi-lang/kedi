```
import numpy as np

class Poly:
  def __init__(self, expr: str):
    self.expr = expr

  def __call__(self, x: float) -> float:
    return eval(self.expr, {"__builtins__": {}}, {"x": x, "np": np})
```

@test_poly_class():
  [poly: Poly] = `Poly("0.5*(x**3) - 2*(x**2) + x + 3")`
  = <`poly(1)`>

@test_poly_class_2():
  = <`Poly("0.5*(x**3) - 2*(x**2) + x + 3")(1)`>

`print(test_poly_class_2())`
`print(test_poly_class())`
= done
