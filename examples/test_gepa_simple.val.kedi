# Simple evaluation suite for GEPA test

@eval: classify_sentiment:
  > data: examples:
    = ```
    return [
      ("I love this!", "positive"),
      ("This is terrible.", "negative"),
      ("It's okay.", "neutral"),
    ]
    ```
  
  > metric: accuracy(examples):
    = ```
    text, expected = examples
    result = classify_sentiment(text)
    correct = result == expected
    feedback = f"Expected '{expected}', got '{result}'" if not correct else None
    return (1.0 if correct else 0.0, feedback)
    ```

