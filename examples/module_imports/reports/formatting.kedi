@format_money(value: float) -> str:
  = `$<`f"{value:.2f}"`>`

@render_inventory_report(products: list, subtotal: float, total: float) -> str:
  = ```
  rows = [
      f"- {product.name}: {product.quantity} x ${product.unit_price:.2f}"
      for product in products
  ]
  rows.extend(
      [
          f"Inventory value: ${subtotal:.2f}",
          f"Discounted total with tax: ${total:.2f}",
      ]
  )
  return "\n".join(rows)
  ```

> export: *
