# Codegen example using > auto: syntax

@summarize_text(text: str) -> str:
  > auto:
    Takes a long text document and produces a concise summary
    that preserves key information while reducing length by approximately 75%.
    The summary should capture the main points and essential details.

[readme_contents: str] = ```
#read file contents from README.md
with open("README.md", "r") as file:
    readme_contents = file.read()
return readme_contents
```
= <summarize_text(`readme_contents`)>
