@test: consolidate_city_info_as_markdown:
  > case: normal_case:
    ```
        city1 = City(
            name="City A",
            history="History A",
            economy="Economy A",
            cuisine="Cuisine A"
        )
        city2 = City(
            name="City B",
            history="History B",
            economy="Economy B",
            cuisine="Cuisine B"
        )
        cities = [city1, city2]
        result = consolidate_city_info_as_markdown(cities, "Country X")
        assert result is not None, f"Expected non-None result, got {result}"
        assert city1.name in result, f"Expected city name {city1.name} in result, got: {result}"
        assert city2.name in result, f"Expected city name {city2.name} in result, got: {result}"
    # Edge Case: Test with an empty list of cities
    ```
  > case: empty_cities:
    ```
        cities = []
        result = consolidate_city_info_as_markdown(cities, "Country X")
        assert result == "", f"Expected empty result for no cities, got: {result}"
    # Edge Case: Test with None as cities argument
    ```
  > case: none_cities:
    ```
        try:
            consolidate_city_info_as_markdown(None, "Country X")
        except TypeError:
            pass
        else:
            assert False, "Expected TypeError when cities is None"
    # Boundary Condition: Test with single city
    ```
  > case: single_city:
    ```
        city = City(
            name="Single City",
            history="Rich history",
            economy="Thriving economy",
            cuisine="Diverse cuisine"
        )
        cities = [city]
        result = consolidate_city_info_as_markdown(cities, "Country Y")
        assert city.name in result, f"Expected city name {city.name} in result, got: {result}"
        assert "Rich history" in result, "Expected city history in result, got: {result}"
        assert "Thriving economy" in result, "Expected city economy in result, got: {result}"
        assert "Diverse cuisine" in result, "Expected city cuisine in result, got: {result}"
    # Edge Case: Test with mixed valid and empty city data
    ```
  > case: mixed_city_data:
    ```
    city_valid = City(
        name="Valid City",
        history="Valid history",
        economy="Valid economy",
        cuisine="Valid cuisine"
    )
    city_empty = City(
        name="Empty City",
        history="",
        economy="",
        cuisine=""
    )
    cities = [city_valid, city_empty]
    result = consolidate_city_info_as_markdown(cities, "Country Z")
    assert city_valid.name in result, f"Expected valid city name {city_valid.name} in result, got: {result}"
    assert "Valid history" in result, "Expected valid city history in result, got: {result}"
    assert "Empty City" in result, "Expected empty city name {city_empty.name} in result, got: {result}"
    # Assuming that empty contents are represented somehow in the markdown, else adjust expectations.
    ```

@consolidate_city_info_as_markdown(cities: list[City], country) -> str:
  = ```
  if cities is None:
      raise TypeError("Cities cannot be None")
  if not cities:
      result = ""
  else:
      markdown = []
      markdown.append(f"# Cities in {country}\n")
      for city in cities:
          markdown.append(f"## {city.name}\n")
          if city.history:
              markdown.append(f"### History\n{city.history}\n")
          if city.economy:
              markdown.append(f"### Economy\n{city.economy}\n")
          if city.cuisine:
              markdown.append(f"### Cuisine\n{city.cuisine}\n")
          markdown.append("\n")
      result = "".join(markdown)
  return result
  ```
