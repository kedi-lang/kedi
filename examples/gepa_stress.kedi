```
import math
import random

def gt_point(n1, n2, mode, alpha):
    if mode == "sum":
        x = n1 + n2
    elif mode == "diff":
        x = n1 - n2
    elif mode == "prod":
        x = n1 * n2
    else:
        x = n1 + n2
    y = alpha * (x**2 - n1 * n2) + (n1 - n2)
    return (float(x), float(y))
```

~Vec2D(x: float, y: float)
~ParseOut(n1: int, n2: int, mode: str)

@hybrid_reasoner(text: str, alpha: float) -> `Vec2D`:
  > optimize: parse_span:
    Given the task description: <text>
    Identify two integers as [n1: int] and [n2: int], and the operation [mode: str] among {"sum", "diff", "prod"}.

  # Fallback parsing to guarantee structured values even if optimize span struggles
  [parsed_defaults: ParseOut] = ```
  import re
  s = str(text)
  m_a = re.search(r"a=(-?\d+)", s, re.IGNORECASE)
  m_b = re.search(r"b=(-?\d+)", s, re.IGNORECASE)
  m_op = re.search(r"op=([a-z]+)", s, re.IGNORECASE)
  if not (m_a and m_b and m_op):
      raise ValueError("Unable to parse defaults from text")
  return {
      'n1': int(m_a.group(1)),
      'n2': int(m_b.group(1)),
      'mode': m_op.group(1)
  }
  ```
  [n1: int] = ```
  try:
      return int(n1)
  except Exception:
      return int(parsed_defaults['n1'])
  ```
  [n2: int] = ```
  try:
      return int(n2)
  except Exception:
      return int(parsed_defaults['n2'])
  ```
  [mode: str] = ```
  val = str(mode).strip().lower() if mode is not None else ''
  if val in ("sum", "diff", "prod"):
      return val
  return str(parsed_defaults['mode'])
  ```

  # Normalize and derive helper values between optimize spans
  # Clamp parsed integers to a safe range to avoid explosive errors
  [n1: int] = `max(-9, min(9, n1))`
  [n2: int] = `max(-9, min(9, n2))`
  [mode_norm: str] = ```
  return mode if mode in ("sum", "diff", "prod") else "sum"
  ```
  [alpha_clamped: float] = ```
  return max(0.1, min(alpha, 1.5))
  ```
  [seed_x: float] = ```
  if mode_norm == "sum":
      return float(n1 + n2)
  elif mode_norm == "diff":
      return float(n1 - n2)
  else:
      return float(n1 * n2)
  ```
  [seed_y: float] = ```
  return float(alpha_clamped * (seed_x**2 - n1 * n2) + (n1 - n2))
  ```

  > optimize: hint_span:
    Based on <n1>, <n2>, operation <mode_norm>, and seed point (<`round(seed_x,3)`>, <`round(seed_y,3)`>), \
    provide a concise [hint: str] describing any simple adjustment (e.g., nudge x toward <`n1+n2`>, "prefer product") \
    that would better align the point with the expected trend.

  # Processing between optimize spans: parse textual hint into numeric adjustments and pre-adjusted seed
  [dx: float] = ```
  hint_l = (hint or '').lower()
  val = 0.0
  if 'increase x' in hint_l:
      val += 0.5
  if 'decrease x' in hint_l:
      val -= 0.5
  return float(val * alpha_clamped)
  ```
  [dy: float] = ```
  hint_l = (hint or '').lower()
  val = 0.0
  if 'increase y' in hint_l:
      val += 0.5
  if 'decrease y' in hint_l:
      val -= 0.5
  return float(val * alpha_clamped)
  ```
  [pre_x: float] = ```
  return float(seed_x + dx)
  ```
  [pre_y: float] = ```
  return float(seed_y + dy)
  ```

  > optimize: compute_span:
    Using <n1>, <n2>, normalized operation <mode_norm>, tuned factor <alpha_clamped>, the advisory <hint>, and \
    pre-adjusted seed (<pre_x>, <pre_y>), produce [p: Vec2D] with fields x and y that best represent the derived point.

  # Post-processing after compute_span: clamp/validate; fallback to pre-adjusted seed when needed
  [p: Vec2D] = ```
  import math
  try:
      x = float(p.x)
      y = float(p.y)
  except Exception:
      x, y = float(pre_x), float(pre_y)
  if not (math.isfinite(x) and math.isfinite(y)):
      x, y = float(pre_x), float(pre_y)
  return {'x': x, 'y': y}
  ```

  = `Vec2D(x=float(p['x']), y=float(p['y']))`

@make_data() -> DataLoader:
  = ```
  import random

  class DataLoader:
      length = 16
      OPS = ["sum", "diff", "prod"]
      def __iter__(self):
          for _ in range(DataLoader.length):
              a = random.randint(-5, 5)
              b = random.randint(-5, 5)
              op = random.choice(DataLoader.OPS)
              alpha = random.uniform(0.1, 1.5)
              text = f"Compute a 2D point from a={a}, b={b}, op={op}. Return vector."
              yield (text, alpha), None
      def __len__(self):
          return DataLoader.length

  return DataLoader()
  ```

@eval: hybrid_reasoner:
  > data: train:
    = ```
    return make_data()
    ```

  > metric: score(train):
    = ```
    # Analytical metric comparing predicted point to ground truth
    # Use dataset tuple directly for robustness across adapters
    text_val, alpha_val = train

    import re, math
    stext = str(text_val)
    m_a = re.search(r"a=(-?\d+)", stext, re.IGNORECASE)
    m_b = re.search(r"b=(-?\d+)", stext, re.IGNORECASE)
    m_op = re.search(r"op=([a-z]+)", stext, re.IGNORECASE)

    a = int(m_a.group(1))
    b = int(m_b.group(1))
    op = m_op.group(1)

    gx, gy = gt_point(a, b, op, alpha_val)
    pred = hybrid_reasoner(text_val, alpha_val)

    try:
        px = float(pred.x)
        py = float(pred.y)
    except Exception as e:
        return (0.0, f"type error: {e}")

    dist = math.sqrt((px - gx)**2 + (py - gy)**2)
    # Softer decay to avoid vanishing scores during early iterations
    score = math.exp(-0.05 * dist)

    # Construct meaningful textual feedback with actionable hints
    # Suggest an operation if prediction seems closer to another op's ground truth
    ops = ["sum", "diff", "prod"]
    best_op = op
    best_err = dist
    for cand in ops:
        tx, ty = gt_point(a, b, cand, alpha)
        d = math.sqrt((px - tx)**2 + (py - ty)**2)
        if d < best_err:
            best_err, best_op = d, cand

    op_suggestion = (f" consider op={best_op}" if best_op != op else "")
    direction = []
    if px < gx:
        direction.append("increase x")
    elif px > gx:
        direction.append("decrease x")
    if py < gy:
        direction.append("increase y")
    elif py > gy:
        direction.append("decrease y")
    adjust = ("; " + ", ".join(direction)) if direction else ""

    fb = (
        f"gt=({gx:.2f},{gy:.2f}) pred=({px:.2f},{py:.2f}) dist={best_err:.3f}."
        f"{op_suggestion}{adjust}"
    )
    return (float(score) + 0.1, fb)
    ```

= `hybrid_reasoner("Compute a 2D point from a=3, b=-2, op=prod. Return vector.", 0.7)`
