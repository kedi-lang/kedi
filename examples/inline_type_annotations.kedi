# Inline Python Type Annotations Example

# This example demonstrates the new backtick-wrapped type annotations feature.

# Basic types with backticks
[x: `int`] = `42`
[y: `str`] = `"hello"`
[z: `float`] = `3.14`

# Complex types with backticks
[numbers: `list[int]`] = `[1, 2, 3, 4, 5]`
[words: `list[str]`] = `["apple", "banana", "cherry"]`

# DSL-defined custom types
~Person(name, age: int)

[person: `Person`] = `Person(name="Alice", age=30)`

# Mixed usage - backtick and regular annotations work together
@process_regular(x: int) -> int:
    = `x * 2`

@process_backtick(x: `int`) -> `int`:
    = `x * 2`

# Procedure with backtick return type
@get_numbers() -> `list[int]`:
    = `[1, 2, 3, 4, 5]`

# Type definition with backtick field annotations
~Team(name, scores: `list[int]`, members: `dict[str, int]`)

[team: Team] = `Team(name="Eagles", scores=[10, 20, 30], members={"Alice": 10, "Bob": 20})`

# All types work interchangeably
= Regular: <`str(process_regular(10))`>, Backtick: <`str(process_backtick(10))`>, Numbers: <`str(len(get_numbers()))`>, Team: <`team.name`>
