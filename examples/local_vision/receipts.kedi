> import: media

###
Read the writing on a receipt image with the local vision model the caller selected.
###
@read(photo: Image) -> str:
  [writing] << Read the writing in <<photo>>.
  = <writing>

###
Turn the lines into items and a total, and check that the items add up. The model only
reads; parsing and the check are ordinary Python, so a misread shows up as a failed check.
###
@check(writing: str) -> dict:
  = ```
  import re

  lines = [line.strip() for line in writing.splitlines() if line.strip()]
  items, total = [], None
  for line in lines[1:]:
      match = re.fullmatch(r"(.+?)\s+(\d+\.\d{2})", line)
      if match is None:
          continue
      name, amount = match.group(1), float(match.group(2))
      if name.upper() == "TOTAL":
          total = amount
      else:
          items.append({"name": name, "price": amount})
  adds_up = total is not None and abs(sum(item["price"] for item in items) - total) < 0.005
  return {
      "merchant": lines[0] if lines else "",
      "items": items,
      "total": total,
      "adds_up": adds_up,
  }
  ```

# score.py binds this file: `photo` arrives as a global.
[writing] = `read(photo)`
= `{"writing": writing, "receipt": check(writing)}`
